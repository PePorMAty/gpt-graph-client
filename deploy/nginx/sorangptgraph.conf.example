# Сайт и API на одном домене: https://sorangptgraph.xyz
#
# ОБРАЗЕЦ, а не готовый файл. Рабочий конфиг собирается из нынешнего: блок
# location /api/ (прокси на pm2, CORS для GitHub Pages, client_max_body_size)
# и строки сертификата, которые вписал certbot, берутся оттуда как есть.
# Здесь показано, что к ним добавляется: сайт по корню, кэш, сжатие,
# заголовки безопасности, редиректы на https и на адрес без www.
#
# Перед применением: копия конфига, затем `nginx -t`, затем
# `systemctl reload nginx` — см. deploy/DEPLOY.md.

# http → https. certbot сам вписывает сюда проверку для продления сертификата.
server {
    listen 80;
    listen [::]:80;
    server_name sorangptgraph.xyz www.sorangptgraph.xyz;
    return 301 https://sorangptgraph.xyz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sorangptgraph.xyz www.sorangptgraph.xyz;

    # ── сертификат: строки из нынешнего конфига (их вписал certbot) ──
    ssl_certificate     /etc/letsencrypt/live/sorangptgraph.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sorangptgraph.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # www → без www: у сайта один адрес, поисковикам так проще.
    if ($host = www.sorangptgraph.xyz) {
        return 301 https://sorangptgraph.xyz$request_uri;
    }

    # Сборка клиента, её кладёт deploy/deploy-site.sh.
    root /var/www/sorangptgraph;
    index index.html;

    include snippets/security-headers.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    # ── API: БЛОК ИЗ НЫНЕШНЕГО КОНФИГА, БЕЗ ИЗМЕНЕНИЙ ──
    # Примерно такой (порт — тот, на котором слушает сервер под pm2):
    # location /api/ {
    #     proxy_pass http://127.0.0.1:3001;
    #     ...
    # }

    # Файлы сборки: в имени хэш содержимого, поэтому кэшировать можно на год.
    location /assets/ {
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Сама страница приложения — без кэша: обновление сайта видно сразу.
    location = /index.html {
        include snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Всё остальное: файл, если он есть (robots.txt, terms.html — и /terms без
    # .html), иначе приложение — его внутренние адреса (/guide, /g/…) знает
    # оно само.
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}
